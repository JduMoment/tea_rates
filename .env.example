# Шаблон настроек. Скопируйте в .env и подставьте свои значения:
#   cp .env.example .env
# .env в git не коммитится, этот файл — коммитится (без настоящих паролей!).

# --- Postgres ---
# Эти же переменные читает контейнер postgres при первом создании базы.
# Если поменяли пользователя/пароль уже после первого запуска — пересоздайте том:
#   docker compose -f deploy/docker-compose.yml down -v
POSTGRES_USER=tea
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tea_rates
# Куда подключается бэкенд, запущенный НЕ в Docker (из PyCharm, uvicorn локально).
# В docker-compose хост/порт переопределяются на db:5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# Можно вместо POSTGRES_* задать строку подключения целиком:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# 1 — печатать SQL-запросы в лог
DB_ECHO=0

# --- сессии ---
SESSION_COOKIE=tea_session
SESSION_TTL_DAYS=30
# 1 — cookie только по HTTPS. Обязательно включить на проде.
COOKIE_SECURE=0

# --- фронт ---
# Каталог со сборкой фронта; по умолчанию <проект>/front/dist
# FRONT_DIST=/abs/path/to/front/dist

# --- вход через Яндекс ID ---
# Публичный адрес сайта без слэша в конце; из него собирается redirect URI
#   <PUBLIC_URL>/api/auth/oauth/yandex/callback
# — он должен быть указан в кабинете https://oauth.yandex.ru (доступы login:info, login:email).
# На проде: PUBLIC_URL=https://5listov.ru
PUBLIC_URL=http://localhost:8000
# Пустые — вход через Яндекс отключён
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# --- загруженные файлы (фото к отзывам) ---
# Каталог на диске; по умолчанию <проект>/media. В docker-compose — том media.
# MEDIA_DIR=/abs/path/to/media
# Префикс адресов файлов (если переедем в облако — адрес бакета или CDN)
# MEDIA_URL=/media
